{
    "name": "ilmedova/chattle",
    "description": "A Laravel package that provides a complete chat system for customer support with admin panel, ticketing system, and real-time messaging using WebSockets.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "chat",
        "Customer support",
        "Laravel Support",
        "Laravel Chat",
        "support chat",
        "Ticketing System",
        "laravel ticket",
        "chattle",
        "mahri",
        "websockets chat",
        "admin chat",
        "laravel websockets",
        "customer chat"
    ],
    "homepage": "https://github.com/ilmedova/chattle",
    "authors": [
        {
            "name": "Mahri Ilmedova",
            "email": "mahri.ilmedova@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "laravel/framework": "^10.0|^11.0",
        "beyondcode/laravel-websockets": "^1.13"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ilmedova\\Chattle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ilmedova\\Chattle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ilmedova\\Chattle\\ChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
